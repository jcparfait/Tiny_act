<%
  mobile_app_url =
    ENV["MOBILE_APP_URL"].presence ||
    Rails.application.credentials.dig(
      :mobile,
      :app_url
    ) ||
    "http://localhost:8081"

  reset_url =
    "#{mobile_app_url}/reset-password" \
    "?reset_password_token=" \
    "#{ERB::Util.url_encode(@token)}"
%>

<p>Bonjour <%= @resource.first_name.presence || @resource.email %>,</p>

<p>
  Une demande de modification de ton mot de passe Tiny Act
  a été effectuée.
</p>

<p>
  <%= link_to "Choisir un nouveau mot de passe", reset_url %>
</p>

<p>
  Si tu n’es pas à l’origine de cette demande,
  tu peux ignorer cet email.
</p>
